rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.superadmin == true;
    }

    function validContentType(contentType) {
      return contentType in [
        'image/jpeg', 'image/png', 'image/webp', 'image/avif',
        'audio/mpeg', 'audio/aac', 'audio/ogg', 'audio/wav', 'video/mp4'
      ];
    }

    function validUpload() {
      return request.resource != null
        && validContentType(request.resource.contentType)
        && request.resource.size > 0
        && (
          (request.resource.contentType.matches('^image/.*')
            && request.resource.size <= 10485760)
          || (request.resource.contentType.matches('^audio/.*')
            && request.resource.size <= 26214400)
          || (request.resource.contentType == 'video/mp4'
            && request.resource.size <= 52428800)
        )
        && request.resource.metadata.visibility in ['private', 'public'];
    }

    match /media/{fileName} {
      allow read: if isSuperadmin()
        || (resource != null && resource.metadata.visibility == 'public');
      allow create: if isSuperadmin() && validUpload();
      allow update: if isSuperadmin()
        && validUpload()
        && request.resource.contentType == resource.contentType
        && request.resource.size == resource.size
        && request.resource.metadata.uploadedBy == resource.metadata.uploadedBy;
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
